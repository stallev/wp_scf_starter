{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.2",
  "themes": ["./wp-content/themes/starter"],
  "plugins": [
    "https://downloads.wordpress.org/plugin/secure-custom-fields.zip",
    "https://downloads.wordpress.org/plugin/wordpress-seo.zip"
  ],
  "mappings": {
    "wp-content/mu-plugins": "./wp-content/mu-plugins"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "local"
  },
  "lifecycleScripts": {
    "afterStart": "node tools/env-setup.mjs"
  }
}
