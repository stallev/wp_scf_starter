{
  "name": "stallev/wp-scf-starter",
  "description": "WordPress theme + mu-plugin + SCF starter for AI-assisted corporate sites",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "php-stubs/acf-pro-stubs": "^6.8",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "lint:syntax": "parallel-lint --exclude vendor --exclude node_modules --exclude example wp-content",
    "lint:cs": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=2G --no-progress",
    "lint": [
      "@lint:syntax",
      "@lint:cs",
      "@analyse"
    ]
  }
}
