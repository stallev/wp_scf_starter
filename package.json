{
  "name": "wp-scf-starter",
  "private": true,
  "type": "module",
  "description": "WordPress theme + mu-plugin + SCF starter for AI-assisted corporate sites",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "env:start": "node tools/wp-env.mjs start",
    "env:stop": "node tools/wp-env.mjs stop",
    "env:clean": "node tools/wp-env.mjs clean all",
    "env:destroy": "node tools/wp-env.mjs destroy",
    "env:logs": "node tools/wp-env.mjs logs",
    "env:update": "node tools/wp-env.mjs start --update",
    "wp": "node tools/wp-env.mjs run cli wp",
    "composer": "node tools/composer.mjs",
    "init": "node tools/init.mjs",
    "build:config": "node tools/build-config.mjs",
    "check:config": "node tools/validate-config.mjs",
    "build:naming": "node tools/naming.mjs build",
    "check:naming": "node tools/naming.mjs check",
    "check:links": "node tools/check-links.mjs",
    "check:rules": "node tools/check-rules-coverage.mjs",
    "check:hardcode": "node tools/check-hardcode.mjs",
    "check:seeds": "node tools/validate-seeds.mjs",
    "check:seed-idempotent": "node tools/check-seed-idempotent.mjs",
    "lint:prototype": "node tools/lint-prototype.mjs",
    "lint:php": "node tools/composer.mjs lint",
    "lint:php:fix": "node tools/composer.mjs lint:fix",
    "fonts:fallback": "node tools/font-fallback-metrics.mjs",
    "images:webp": "node tools/convert-to-webp.mjs",
    "psi": "node tools/psi.mjs",
    "test:tools": "node --test \"tools/__tests__/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:static": "playwright test --project=static",
    "test:e2e:navigation": "playwright test --project=navigation-*",
    "test:e2e:forms": "playwright test --project=forms",
    "test:e2e:dynamic": "playwright test --project=dynamic",
    "test:e2e:seo": "playwright test --project=seo",
    "test:e2e:perf-markup": "playwright test --project=perf-markup",
    "test:e2e:console": "playwright test --project=console",
    "test:e2e:a11y": "playwright test --project=a11y",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:smoke": "node tools/gate.mjs e2e smoke",
    "test:e2e:ui": "playwright test --ui",
    "gate:rules": "npm run check:naming && npm run check:links && npm run check:rules",
    "gate:0": "npm run check:config && npm run gate:rules && npm run check:hardcode && npm run check:seeds && npm run lint:php",
    "gate:1": "npm run lint:prototype && npm run check:config",
    "gate:2": "npm run check:seeds && npm run check:naming",
    "gate:3": "npm run lint:php && npm run check:seed-idempotent",
    "gate:4": "npm run check:config && npm run check:hardcode && node tools/gate.mjs e2e 4",
    "gate:5": "npm run check:config && npm run check:hardcode && npm run lint:php && node tools/gate.mjs e2e 5",
    "gate:6": "npm run check:config && npm run check:seeds && npm run lint:php && node tools/gate.mjs e2e 6",
    "gate:7": "npm run gate:0 && npm run test:tools && node tools/gate.mjs e2e 7",
    "gate:page": "node tools/gate.mjs page"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@wordpress/env": "^10.0.0",
    "ajv": "^8.17.1",
    "fontkit": "^2.0.4",
    "minimatch": "^10.2.6",
    "node-html-parser": "^7.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4"
  }
}
