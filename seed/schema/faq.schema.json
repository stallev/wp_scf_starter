{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "faq.schema.json",
  "title": "Seed: FAQ",
  "description": "seed/faq.json → CPT starter_faq (starter_seed_import_faq).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "title"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable ASCII slug: the record is found by it on every run."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Question."
          },
          "content": {
            "type": "string",
            "description": "Answer (HTML allowed)."
          },
          "location": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "\"home\" or the last segment of a pages-map URL."
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
