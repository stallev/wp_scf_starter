{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "company.schema.json",
  "title": "Seed: company",
  "description": "seed/company.json → SCF options page starter-company (starter_seed_map_company). Only present keys are written.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "business_type": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Za-z]+)?$",
      "description": "schema.org LocalBusiness subtype, e.g. ProfessionalService."
    },
    "phones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "\\d"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "email": {
      "type": "string",
      "pattern": "^(?:[^@\\s]+@[^@\\s]+\\.[^@\\s]+)?$"
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "street": {
          "type": "string"
        },
        "locality": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "pattern": "^(?:[A-Z]{2})?$",
          "description": "ISO 3166-1 alpha-2."
        },
        "text": {
          "type": "string"
        }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "hours_text": {
      "type": "string"
    },
    "opening_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "days",
          "opens",
          "closes"
        ],
        "properties": {
          "days": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday",
                "Sunday"
              ]
            }
          },
          "opens": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "closes": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-4]):[0-5]\\d$"
          }
        }
      }
    },
    "socials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "network",
          "url"
        ],
        "properties": {
          "network": {
            "enum": [
              "telegram",
              "whatsapp",
              "viber",
              "instagram",
              "vk",
              "facebook",
              "youtube",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^(?:https?|viber|tg)://\\S+$"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "ga4_id": {
      "type": "string",
      "pattern": "^(?:G-[A-Z0-9]+)?$",
      "description": "Empty = analytics off. Never commit a client ID to the starter."
    },
    "area_served": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "price_range": {
      "type": "string"
    },
    "default_image": {
      "type": "string",
      "description": "Absolute http(s) URL or a path relative to seed/ (e.g. images/x.jpg).",
      "pattern": "^(?:https?://\\S+|(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.(?:jpe?g|png|webp|gif|avif|svg))$"
    }
  }
}
