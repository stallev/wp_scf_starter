{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "modules/catalog/product-families.schema.json",
  "title": "Seed: catalog product families",
  "description": "seed/modules/catalog/product-families.json → taxonomy starter_product_family (starter_seed_import_product_families, catalog module).",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "$schema": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable ASCII slug: the term is found by it on every run."
          },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    }
  }
}
