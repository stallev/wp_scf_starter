{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "posts.schema.json",
  "title": "Seed: posts",
  "description": "seed/posts.json → post + category (starter_seed_import_posts).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "title"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable ASCII slug: the record is found by it on every run."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$"
          },
          "categories": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "slug": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "Stable ASCII slug: the record is found by it on every run."
                    }
                  }
                }
              ]
            }
          },
          "image": {
            "type": "string",
            "description": "Absolute http(s) URL or a path relative to seed/ (e.g. images/x.jpg).",
            "pattern": "^(?:https?://\\S+|(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.(?:jpe?g|png|webp|gif|avif|svg))$"
          }
        }
      }
    }
  }
}
