  "forbidden": [
    {
      "id": "legacy-prefix",
      "pattern": "\\b(?:t[b]|T[B])[_-][A-Za-z]",
      "reason": "Префикс исходного проекта (legacy)",
      "replace": "starter_ / STARTER_ / starter-core"
    },
    {
      "id": "legacy-docs-path",
      "name": "wp-integration-docs",
      "reason": "Устаревший путь документации из черновиков исходного проекта",
      "replace": "docs/"
    },
    {
      "id": "unprefixed-cpt-register",
      "pattern": "register_post_type\\(\\s*['\"](?!starter_)",
      "paths": [
        "wp-content/**/*.php"
      ],
      "reason": "CPT без префикса: коллизии с плагинами и ядром",
      "replace": "starter_<entity> в post-types.php"
    },
    {
      "id": "unprefixed-cpt-query",
      "pattern": "['\"]post_type['\"]\\s*=>\\s*['\"](?:product|lead|review|project|faq)['\"]",
      "paths": [
        "wp-content/**/*.php"
      ],
      "reason": "CPT без префикса (product, lead, review, project, faq)",
      "replace": "starter_lead, starter_review, starter_project, starter_faq"
    },
    {
      "id": "unprefixed-taxonomy",
      "pattern": "register_taxonomy\\(\\s*['\"](?!starter_)",
      "paths": [
        "wp-content/**/*.php"
      ],
      "reason": "Taxonomy без префикса",
      "replace": "starter_<name>"
    },
    {
      "id": "blog-cpt",
      "pattern": "\\bstarter_(?:blog|article|news)\\b",
      "paths": [
        "wp-content/**",
        "seed/**"
      ],
      "reason": "Отдельный CPT для блога не нужен",
      "replace": "post + category"
    },
    {
      "id": "frontend-enqueue-in-core",
      "pattern": "add_action\\(\\s*['\"]wp_enqueue_scripts['\"]",
      "paths": [
        "wp-content/mu-plugins/**"
      ],
      "reason": "Mu-plugin = данные; front-end assets подключает только тема",
      "replace": "wp-content/themes/starter/inc/assets.php (admin assets в mu-plugin допустимы через admin_enqueue_scripts)"
    },
    {
      "id": "second-json-ld",
      "pattern": "application/ld\\+json",
      "paths": [
        "wp-content/**"
      ],
      "reason": "Второй JSON-LD вне Yoast graph",
      "replace": "Yoast graph piece (starter-core/seo/*, фильтр wpseo_schema_graph_pieces)"
    },
    {
      "id": "custom-title",
      "pattern": "<title>|\\bwp_title\\s*\\(",
      "paths": [
        "wp-content/**/*.php"
      ],
      "reason": "Title и meta генерирует только Yoast (title-tag)",
      "replace": "add_theme_support( 'title-tag' ) + Yoast"
    },
    {
      "id": "external-font-cdn",
      "pattern": "fonts\\.(?:googleapis|gstatic)\\.com|use\\.typekit\\.net",
      "paths": [
        "wp-content/**"
      ],
      "reason": "Шрифты с чужого CDN: лишний origin в критическом пути",
      "replace": "Локальные variable woff2 + preload из project.config.json → fonts.preload"
    },
    {
      "id": "query-posts",
      "pattern": "\\bquery_posts\\s*\\(",
      "paths": [
        "wp-content/**/*.php"
      ],
      "reason": "Ломает главный запрос и пагинацию",
      "replace": "WP_Query / get_posts / pre_get_posts"
    },
    {
      "id": "scf-by-key",
      "pattern": "\\b(?:get_field|the_field|update_field)\\(\\s*['\"]field_[A-Za-z0-9_]+['\"]",
      "paths": [
        "wp-content/**/*.php"
      ],
      "reason": "SCF читается по name, не по key",
      "replace": "get_field( 'starter_…', … ) / starter_field()"
    },
    {
      "id": "hardcoded-ga4-id",
      "pattern": "\\bG-(?!X+\\b)[A-Z0-9]{6,}\\b",
      "paths": [
        "wp-content/**",
        "seed/**",
        "tools/**"
      ],
      "reason": "ID аналитики клиента не попадает в код и seed стартера",
      "replace": "Поле starter_company_ga4_id (опции starter-company)"
    },
    {
      "id": "prototype-data-fetch",
      "pattern": "fetch\\(\\s*['\"][^'\"]*data/[^'\"]*\\.json",
      "paths": [
        "wp-content/themes/**/*.js"
      ],
      "reason": "Файлы данных прототипа в WordPress отдают 404",
      "replace": "Данные из разметки или window.STARTER_* (wp_add_inline_script)"
    },
    {
      "id": "yoast-llms-txt",
      "name": "enable_llms_txt",
      "paths": [
        "wp-content/**",
        "tools/**"
      ],
      "reason": "Yoast-генерация /llms.txt конфликтует с курируемым файлом",
      "replace": "starter-core/llms-txt.php"
    }
  ],
  "legacy": [
    {
      "from": "{prefix} / {core} / {theme} исходного проекта (ADR 0001, плейсхолдеры)",
      "to": "`starter_*` / `starter-core` / `starter`"
    },
    {
      "from": "CPT product / lead / review / project / faq",
      "to": "starter_<entity>"
    },
    {
      "from": "Options slug company-settings / *-company без префикса",
      "to": "starter-company"
    },
    {
      "from": "Правило product-doc-alignment.mdc (always-on)",
      "to": "/doc-align (.claude/commands/doc-align.md)"
    },
    {
      "from": "Запреты имён в нескольких документах",
      "to": "docs/contracts/naming.json (этот файл)"
    }
  ]
}
