# Copy to .env (gitignored). Never commit real values. UTF-8 without BOM
# (in Windows PowerShell 5.1 do not create it with `>` / Out-File).

# PageSpeed Insights API key — manual PSI runs only (docs/playbooks/psi.md).
# Google Cloud Console -> APIs & Services -> Credentials; restrict to PageSpeed Insights API.
PAGESPEED_API_KEY=

# Optional: override base URL for Playwright (defaults to urls.local in project.config.json).
PLAYWRIGHT_BASE_URL=
